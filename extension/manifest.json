{
  "manifest_version": 3,
  "name": "Riff: inspiration library",
  "short_name": "Riff",
  "version": "0.1.0",
  "description": "Click something you like on any website, say why, and Riff saves it with its real design values to your own GitHub inspiration repo.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Riff: pick something you like (Alt+R)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Pick something you like"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
